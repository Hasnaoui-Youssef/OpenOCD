#cmakedefine HAVE_REALPATH 1
#cmakedefine HAVE_STRNDUP 1
#cmakedefine HAVE_STRNLEN 1
#cmakedefine HAVE_USLEEP 1

/* --- Types --- */
#cmakedefine HAVE_ELF64 1
#cmakedefine HAVE_LONG_LONG_INT 1
#cmakedefine HAVE_UNSIGNED_LONG_LONG_INT 1
#cmakedefine HAVE__BOOL 1
#cmakedefine STDC_HEADERS 1

/* --- Dependency-derived (see OpenOCDDependencies.cmake) --- */
#cmakedefine HAVE_LIBFTDI_TCIOFLUSH 1
#cmakedefine HAVE_LIBGPIOD1_FLAGS_BIAS 1
#cmakedefine HAVE_LIBUSB1 1
#cmakedefine HAVE_LIBUSB_GET_PORT_NUMBERS 1
/* #if-tested, see the note at the top of this file. */
#cmakedefine01 HAVE_CAPSTONE

/* --- Host OS summary (#if-tested: always 0 or 1) --- */
#cmakedefine01 IS_CYGWIN
#cmakedefine01 IS_DARWIN
#cmakedefine01 IS_MINGW
#cmakedefine01 IS_WIN32

/* --- Parallel port backend selection (#if-tested) ---
 * Simplified vs. configure.ac's i?86/x86-only ppdev gate: PARPORT defaults
 * OFF in this build, so exactness here is low-stakes. PPDEV on Linux,
 * GIVEIO on Windows (mingw/cygwin), neither otherwise. */
#cmakedefine01 PARPORT_USE_GIVEIO
#cmakedefine01 PARPORT_USE_PPDEV

/* Must declare 'environ' to use it (#ifdef-tested via replacements.h). */
#cmakedefine NEED_ENVIRON_EXTERN 1

/* --- Package identity (static, from AC_INIT in configure.ac:4-5) --- */
#define PACKAGE "openocd"
#define PACKAGE_BUGREPORT "OpenOCD Mailing List <openocd-devel@lists.sourceforge.net>"
#define PACKAGE_NAME "openocd"
#define PACKAGE_STRING "openocd @OPENOCD_PACKAGE_VERSION@"
#define PACKAGE_TARNAME "openocd"
#define PACKAGE_URL ""
#define PACKAGE_VERSION "@OPENOCD_PACKAGE_VERSION@"
#define VERSION "@OPENOCD_PACKAGE_VERSION@"

/* WORDS_BIGENDIAN: dropped the AC_APPLE_UNIVERSAL_BUILD fallback machinery
 * (macOS is out of scope), just the plain #if-tested case. */
#cmakedefine01 WORDS_BIGENDIAN

/* Debug/verbose logging toggles (#ifdef-tested, see OpenOCDOptions.cmake). */
#cmakedefine _DEBUG_FREE_SPACE_ 1
#cmakedefine _DEBUG_USB_COMMS_ 1
#cmakedefine _DEBUG_USB_IO_ 1

/* Use GNU C library extensions (e.g. strndup). */
#define _GNU_SOURCE 1
