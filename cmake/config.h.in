/* config.h - generated by CMake from cmake/config.h.in, replacing autoheader's
 * config.h.in + configure's config.h. Reference: openocd_fork/config.h (same
 * commit, built by Autotools) documents every macro's exact comment text.
 *
 * IMPORTANT: every BUILD_* macro and HAVE_CAPSTONE are tested in the sources
 * with `#if MACRO`, not `#ifdef MACRO` (verified by grep, e.g.
 * src/jtag/drivers/cmsis_dap.c:43 `#if BUILD_CMSIS_DAP_USB == 1`,
 * src/jtag/hla/hla_layout.c:48 `#if BUILD_HLADAPTER_STLINK`). They use the
 * CMake "always 0 or 1" template directive (see CMake's configure_file
 * docs, the "01" variant), which always emits a numeric 0 or 1, never a
 * bare `#define NAME` with no value - the latter would compile to a
 * preprocessor syntax error the moment the option is turned ON. All other
 * HAVE_* macros are #ifdef-tested, so the plain define-or-absent template
 * directive is correct for those.
 *
 * NOTE TO EDITORS: never write the literal template directive token in a
 * comment in this file (spelled out: the six-letter word "cmakedefine",
 * optionally followed by "01", preceded by '#') - configure_file() does not
 * understand C comments and will match and rewrite that line even inside
 * /[asterisk] ... [asterisk]/, silently corrupting the comment (hit this
 * for real while writing this file; see cmake/jimautoconf.h.in history).
 */

/* --- Adapter/driver selection (all #if-tested, always-0-or-1 macros) --- */
