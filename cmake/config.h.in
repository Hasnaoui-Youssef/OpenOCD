#cmakedefine01 BUILD_FT232R
#cmakedefine01 BUILD_FTDI
#cmakedefine01 BUILD_GW16012
#cmakedefine01 BUILD_HLADAPTER
#cmakedefine01 BUILD_HLADAPTER_ICDI
#cmakedefine01 BUILD_HLADAPTER_NULINK
#cmakedefine01 BUILD_HLADAPTER_STLINK
#cmakedefine01 BUILD_IMX_GPIO
